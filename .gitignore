# Data files — never commit raw microscopy data to git
*.h5
*.hdf5
*.tif
*.tiff
*.nd2
*.czi

# Results outputs
outputs/
pombe_results/
measurements.csv
*.png
*.svg
*.pdf

# Validation run outputs (blinded images, key files, comparison CSVs —
# all derived from real experimental data, never commit)
validation/runs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Cellpose model cache (large, auto-downloaded)
*.npy

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Allow the bundled sample dataset
!data/sample/*.h5
!data/sample/*.hdf5

# Allow documentation figures
!docs/**/*.png
!docs/**/*.pdf
# Large validation packages
validation/*.zip
# Septin masks/projections, results and the division-classifier labelling package
# (derived from unpublished lab microscopy data, never commit)
septin_curve_vis/derived/
septin_curve_vis/*division_package*/
septin_curve_vis/0*/
septin_curve_vis/0*_results/
septin_curve_vis/0*_test/

# Figures referenced by validation reports
!validation/reports/**/*.png

# Preprint draft: private until the lab decides to share it
paper/

# bsd run folders, logs, local copies of talks
runs/
*.log
docs/*.pptx
docs/*Symposium*
